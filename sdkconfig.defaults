# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
# 20 ms display refresh period targets up to 50 FPS when rendering and SPI
# transfer complete within the same budget.
CONFIG_LV_DEF_REFR_PERIOD=30
CONFIG_LV_FONT_MONTSERRAT_12=y
# 只编 12 和 44 两套字模：主文字用 12，频率大字用原生 44 px
# （用 transform_scale 放大 28 号会被圆角遮罩裁切，见 802bbc8 的注释）。
CONFIG_LV_FONT_MONTSERRAT_44=y
# LVGL 分配器：默认改用系统堆的标准 malloc/realloc/free。
# 内置 24KB 静态池在复杂圆角/蒙版绘制时会耗尽，lv_malloc 返回 NULL 后 LVGL 断言死循环，
# 饿死 IDLE 触发 TWDT 冻屏（真机已复现：圆角蒙版表分配失败）。系统堆约 130KB 可用，
# 不会占用额外静态区；仍可按需改回内置池并调 CONFIG_LV_MEM_SIZE_KILOBYTES。
CONFIG_LV_USE_CLIB_MALLOC=y

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000

# --- Wi-Fi / 网络 ---
# 局域网里只有 IPv4 服务端；IPv6 的 lwIP 代码和数据是白花的内部 RAM。
# 服务端 w103d.vlsc.net 只有 AAAA 记录，设备必须能走 IPv6。
CONFIG_LWIP_IPV6=y
# 没有这一项，设备不会接收 Router Advertisement，就拿不到全局 IPv6。
CONFIG_LWIP_IPV6_AUTOCONF=y
# 平时只做 STA，但首次配网需要设备自己开热点（见 main/mrrc_prov.c），
# 所以 AP 支持必须编进去。它只在配网时启用，那时 TLS/WS 还没起。
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# --- lwIP TCP 窗口 ---
# 默认 5760 B 是 4×MSS，对这条链路根本不成立：下行是 31 KB/s 音频 + 18 KB/s 频谱
# = 50 KB/s，而实测 RTT 54–211 ms（平均 82）。吞吐 ≈ WND/RTT，5760/0.082 ≈ 70 KB/s
# 只在平均 RTT 下勉强够，RTT 一尖峰就掉到 27 KB/s 以下，服务端的 write 被反压
# （它的日志里叫 pump stall），音频就以突发形式到达、设备侧卡顿。
# 实测：同 Wi-Fi 的 Linux 盒子能稳定收到 50 帧/秒音频；设备只有 18.5 帧/秒。
# --- 设备接收能力（下行 30 KB/s 音频 + 15 KB/s 频谱）---
# 只加大窗口无效，真正卡住的是"窗口背后的队列"：
#   TCP_RECVMBOX_SIZE 6   每连接只有 6 个 pbuf 能排队给应用，满了就不再收
#   RX_BA_WIN 6           A-MPDU 块确认窗口只有 6，突发时收不进
# 三者一起抬才有意义；窗口按 8 个 MSS 取。
CONFIG_LWIP_TCP_WND_DEFAULT=11520
# 上行：发射时 32 KB/s 的 PCM 与 49 KB/s 的下行共用一条连接，SND_BUF 只有
# 4 个 MSS 时 send_bin() 会等 ACK；实测最坏一次阻塞 84 ms（NODELAY 之前 89）。
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=8
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=8
CONFIG_ESP_WIFI_RX_BA_WIN=16

# --- TLS ---
# TLS 会话是本项目最贵的一项固定开销（每条连接十几 KB）。已定策略：V1 只开
# 一条，证书校验在拿到实测数字后再补；探针阶段先不加载整包 cert bundle。
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=6144
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=2048
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# --- Bluetooth LE / NimBLE ---
# MRRC 终端不用 BLE。NimBLE controller + host 常驻会吃掉几十 KB 内部 RAM，
# 而这颗 C3 的全部预算只有 400 KB（无 PSRAM）。真要蓝牙时再单独验一次内存。
CONFIG_BT_ENABLED=n

# --- Opus ---
# micro-opus defaults to a 120 KB pseudostack.  This board has no PSRAM, so that
# would come straight out of the ~114 KB we have left.  Measured on the host:
# decoding overflows below 8 KB, 16 kHz encoding below 24 KB, 48 kHz below
# 32 KB.  Only decoding happens in S2, so 16 KB leaves 2x margin.
CONFIG_OPUS_PSEUDOSTACK_SIZE=60000
# Fixed point: ESP32-C3 has no FPU at all (SOC_CPU_HAS_FPU is not defined).
# CONFIG_OPUS_FLOATING_POINT is not set

# --- 性能 ---
# 默认是 -Og。这颗 C3 没 FPU，Opus 解码与音频重采样全靠整数运算；
# -O2 在这里不是"锦上添花"，是能不能实时解码的前提。
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 日志：保留 INFO（运行期诊断仍需要），但热路径里的逐帧日志已在代码层删除。
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# 排查卡顿时设为 y：每分钟多打 link / ws / txlink 三行（收字节、环空唤醒、
# I2S 写阻塞、发射发送耗时）。实测数据与排查方法见 docs/transport-tuning.md。
# 出货构建保持关闭。
# CONFIG_MRRC_PROFILE is not set

# ── LVGL 性能（实测，见 docs/optimization-notes.md 3.4）────────────────
# 官方指南：帧缓冲 <10% 屏面积有"严重负面影响"。240x320 的 10% = 32 行。
# 绘制缓冲行数在 components/bsp/src/bsp_display_lvgl.c 的
# BSP_LVGL_DRAW_BUFFER_LINES 里，不在 sdkconfig。
#
# 不要再打开 CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM。它曾把"最热的 LVGL 函数"
# 放进 IRAM 换掉 flash cache 等待，但 lvgl/lvgl 的版本约束是 ^9.5.0，实际会解析到
# 9.6.x，而 9.6 给大量绘制函数加了 LV_ATTRIBUTE_FAST_MEM。于是这一项会把
# ~117 KB 的代码搬进 SRAM（C3 的 IRAM/DRAM 是同一块 400 KB）。实测后果：
#   DRAM 占用 170 KB -> 287 KB，启动堆 201 KB -> 88 KB，
#   esp_wifi_init() 直接 ESP_ERR_NO_MEM，设备无限重启。
# 若要恢复该性能选项，必须先把 lvgl 钉到 9.5.*，并重新验证启动堆。
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set
